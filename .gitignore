/target
docs/superpowers/
.superpowers/

# Agent worktrees (<repo>/.claude/worktrees/<branch>) — full checkouts of this repo's own
# branches; committing them would be circular. Tracked here so a fresh clone is covered.
.claude/worktrees/

# Generated at build time from the pinned chrome-core crate (build.rs); reproducible, not tracked
/crates/warden-app/ui/chrome-core.css
/crates/warden-app/ui/chrome-core.js

# Generated at build time from the pinned shell-core crate (build.rs); reproducible, not tracked.
# The tracked scripts/tooling.env supplies the per-app params. Edit these in shell-core, not here.
/scripts/release.sh
/scripts/gen-latest-json.sh
/scripts/install-app.sh
/scripts/launch-app.sh

# Tauri generated
crates/warden-app/gen/

# Release artifacts built by scripts/release.sh (uploaded to GitHub, not tracked)
/warden-*-macos.zip

# `just seed-examples` git-inits the mock example project dirs into real repos so the
# [[window.root]] tree demo has something to discover — those local .git dirs aren't tracked.
examples/projects/**/.git/

# Generated updater manifest (scripts/gen-latest-json.sh, for a release upload)
/latest.json
.DS_Store
